<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Ink ramp on true black, for OLED.

        The page background is #000000 so those pixels are switched off: on OLED that is less
        power, and the reticle reads against a genuinely black field instead of a lifted grey.
        Surfaces above it step up in small increments rather than jumping, because the contrast
        against pure black is what carries the hierarchy, not a bright fill.

        Everything here is fully opaque. The panel sits over live gameplay, and a see-through
        panel is harder to read against a bright scene than a solid one, so controls are solid
        steps of the ramp rather than white at low alpha.
    -->
    <color name="void_bg">#000000</color>
    <color name="surface">#0E0E11</color>
    <color name="panel">#0A0A0C</color>

    <!-- Solid control fills. Steps up from the panel, not white at low alpha. -->
    <color name="ghost">#141419</color>
    <color name="ghost_high">#1C1C22</color>
    <color name="raised">#1A1A20</color>

    <!-- Hairlines and tracks. Kept off pure black so an edge still reads as an edge. -->
    <color name="hairline">#24242C</color>
    <color name="track">#2A2A33</color>

    <color name="accent">#C6A9F2</color>
    <color name="accent_pressed">#B494E6</color>
    <color name="on_accent">#17122A</color>
    <color name="readout">#C7D0DE</color>

    <color name="text">#EEF1F7</color>
    <color name="muted">#97A1B4</color>
    <color name="danger">#E06B79</color>

    <!--
        The colour swatches. A well light enough that the black swatch still reads as a dot,
        and dark enough that the white one does too. It is opaque, like every other surface.
    -->
    <color name="swatch_well">#434B5E</color>
</resources>
