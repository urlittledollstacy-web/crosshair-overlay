<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Crosshair" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:statusBarColor">@color/void_bg</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!--
        The picker dialog. Without an explicit dark parent the platform builds a light
        AlertDialog, which would land as a white slab on the dark app.
    -->
    <style name="Theme.Crosshair.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:background">@color/surface</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Used for views inflated by the service, which has no activity theme of its own. -->
    <style name="Theme.Crosshair.Overlay" parent="android:Theme.DeviceDefault">
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- Quiet field labels, sentence case. -->
    <style name="Label">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Live figures, set in mono so they read like instrument values. -->
    <style name="Readout">
        <item name="android:textColor">@color/readout</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Pill">
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
</resources>
