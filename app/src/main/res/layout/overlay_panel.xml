<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="20dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/panel_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sigil" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/panel_title"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/panel_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_ghost"
                    android:clickable="true"
                    android:contentDescription="@string/close"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Crosshair picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_crosshair" />

                <TextView
                    android:id="@+id/value_crosshair"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/picker_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="5" />

            <!-- Colour -->
            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_colour" />

            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <!-- Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_size" />

                <TextView
                    android:id="@+id/value_size"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/step_size_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/decrease"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/seek_size"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/step_size_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/increase"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Opacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_opacity" />

                <TextView
                    android:id="@+id/value_opacity"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_opacity"
                style="@style/Slider" />

            <TextView
                android:id="@+id/opacity_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/opacity_warning"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Horizontal position -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_x" />

                <TextView
                    android:id="@+id/value_x"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/step_x_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/decrease"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/seek_x"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/step_x_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/increase"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Vertical position -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_y" />

                <TextView
                    android:id="@+id/value_y"
                    style="@style/Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/step_y_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/decrease"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/seek_y"
                    style="@style/Slider"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/step_y_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:contentDescription="@string/increase"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/move_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/move_hint"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_visible"
                    style="@style/Pill"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.4"
                    android:text="@string/crosshair_on" />

                <TextView
                    android:id="@+id/btn_move"
                    style="@style/Pill"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/move" />

                <TextView
                    android:id="@+id/btn_center"
                    style="@style/Pill"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/center" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_stop"
                style="@style/Pill"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_danger"
                android:text="@string/stop"
                android:textColor="@color/danger" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
